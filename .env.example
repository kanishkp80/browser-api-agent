# Load these variables in the process environment. The service does not parse .env files.
OPENAI_API_KEY=
BROWSER_API_BROWSER_HOST=local
BROWSER_API_DATA_DIR=.browser-api
BROWSER_API_HOST=127.0.0.1
BROWSER_API_PORT=8765
BROWSER_API_CONTROL_BASE_URL=http://127.0.0.1:8765
# Optional locally: if omitted, generated once in DATA_DIR/service-token.
# Required when listening on a non-loopback host; at least 32 characters.
BROWSER_API_SERVICE_TOKEN=
BROWSER_API_HEADLESS=false
BROWSER_API_DISCOVERY_BUDGET_MS=600000
BROWSER_API_ACTION_TIMEOUT_MS=30000
BROWSER_API_HEARTBEAT_MS=15000
# Optional local browser override:
# BROWSER_API_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# E2B server deployments:
# BROWSER_API_BROWSER_HOST=e2b
# E2B_API_KEY=
# BROWSER_API_E2B_TEMPLATE=
# BROWSER_API_CONTROL_BASE_URL=https://your-control-service.example
# Enable only for a trusted loopback fixture; not needed for Powder or Reducto.
BROWSER_API_ALLOW_LOCAL_SITES=false
