{
  "openapi": "3.0.0",
  "info": {
    "title": "Powder",
    "description": "Welcome to Powder! This guide provides an overview of our API endpoints and answers to frequently asked questions. For detailed information on individual endpoints, please refer to our endpoint-specific documentation.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.powderfi.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1.0/public/file_uploads/": {
      "post": {
        "tags": [
          "/file_uploads"
        ],
        "summary": "Upload",
        "operationId": "file_uploads",
        "description": "Upload financial documents (PDF, PNG, JPEG, XLSX) with a statement_type and optional portfolio_id.\n\nSupported file formats: `.pdf`, `.xlsx`, `.png`, `.jpg`, `.jpeg`\n\nYou can optionally specify `source_firm_id` to indicate the originating firm (by ID or name).\n\nIf the file fails validation (e.g. password-protected, corrupt, empty), a `422` response is returned with a specific `error_code`. See the 422 response schema for all possible codes.",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "portfolio_id": {
                    "type": "integer",
                    "description": "Portfolio ID"
                  },
                  "statement_type": {
                    "type": "string",
                    "enum": [
                      "brokerage",
                      "tax_forms",
                      "insurance_forms",
                      "will_forms",
                      "trust",
                      "balance_sheet"
                    ],
                    "description": "Type of statement"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "File to process"
                  },
                  "source_firm_id": {
                    "type": "string",
                    "description": "The originating firm for this document. Accepts either the firm's numeric ID or its name."
                  }
                },
                "required": [
                  "file",
                  "statement_type"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "File upload ID"
                    },
                    "status": {
                      "type": "string",
                      "description": "Initial upload status"
                    },
                    "portfolio_id": {
                      "type": "integer",
                      "description": "Portfolio ID"
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ]
                },
                "examples": {
                  "Created": {
                    "summary": "Created",
                    "value": {
                      "id": 769,
                      "status": "uploaded",
                      "portfolio_id": 580
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request — invalid parameters or upload failure",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "description": "Field-level validation errors"
                    },
                    "message": {
                      "type": "string",
                      "description": "Error description"
                    }
                  }
                },
                "examples": {
                  "Missing file": {
                    "summary": "Missing file",
                    "value": {
                      "error": {
                        "file": [
                          "No file was submitted."
                        ],
                        "statement_type": [
                          "This field is required."
                        ]
                      }
                    }
                  },
                  "Upload failure": {
                    "summary": "Upload failure",
                    "value": {
                      "message": "There was an error uploading the file"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — no access to the specified portfolio",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Access denied description"
                    }
                  },
                  "required": [
                    "message"
                  ]
                },
                "examples": {
                  "Forbidden": {
                    "summary": "Forbidden",
                    "value": {
                      "message": "Cannot access the portfolio with id: 678"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity — file failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Human-readable error description"
                    },
                    "error_code": {
                      "type": "string",
                      "description": "Validation error code identifying the specific file issue.",
                      "enum": [
                        "PASSWORD_PROTECTED_PDF",
                        "CORRUPT_PDF",
                        "TRUNCATED_PDF",
                        "UNREADABLE_PDF",
                        "EMPTY_PDF",
                        "INVALID_PDF_HEADER",
                        "PDF_FILE_READ_ERROR",
                        "PASSWORD_PROTECTED_EXCEL",
                        "CORRUPT_EXCEL_ZIP",
                        "INVALID_EXCEL_FILE",
                        "INVALID_EXCEL_FORMAT",
                        "EMPTY_EXCEL",
                        "EXCEL_FILE_TOO_LARGE",
                        "EXCEL_FILE_READ_ERROR",
                        "UNSUPPORTED_FILE_TYPE"
                      ]
                    }
                  },
                  "required": [
                    "message",
                    "error_code"
                  ]
                },
                "examples": {
                  "Password Protected PDF": {
                    "summary": "Password Protected PDF",
                    "value": {
                      "message": "The uploaded PDF is password-protected. Please remove the password and upload again.",
                      "error_code": "PASSWORD_PROTECTED_PDF"
                    }
                  },
                  "Empty Excel": {
                    "summary": "Empty Excel",
                    "value": {
                      "message": "The uploaded Excel file appears to be empty (no worksheets).",
                      "error_code": "EMPTY_EXCEL"
                    }
                  },
                  "Unsupported File Type": {
                    "summary": "Unsupported File Type",
                    "value": {
                      "message": "Unsupported file type (.doc). Supported formats: .jpeg, .jpg, .pdf, .png, .xlsx",
                      "error_code": "UNSUPPORTED_FILE_TYPE"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1.0/public/file_uploads/{id}": {
      "get": {
        "tags": [
          "/file_uploads/{id}"
        ],
        "summary": "Check Status",
        "operationId": "file_uploads_status",
        "description": "Get the processing status of a specific uploaded document by ID.\n\nThe `status` field indicates the current processing state. When status is `closed`, the response includes an `error` object with a `code` and human-readable `message` explaining why the file could not be processed.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "File upload ID"
          }
        ],
        "responses": {
          "200": {
            "description": "File upload status retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "File upload ID"
                    },
                    "status": {
                      "type": "string",
                      "description": "File processing status.",
                      "enum": [
                        "uploaded",
                        "processing",
                        "in_review",
                        "done",
                        "failed",
                        "error",
                        "closed"
                      ]
                    },
                    "portfolio_id": {
                      "type": "integer",
                      "description": "Portfolio ID"
                    },
                    "error": {
                      "type": "object",
                      "description": "Error details (only present when status is `closed`)",
                      "properties": {
                        "code": {
                          "type": "string",
                          "description": "Close-out error code indicating why the file could not be processed.",
                          "enum": [
                            "password_protected",
                            "missing_pages",
                            "missing_holdings",
                            "unsupported_document",
                            "file_corrupted",
                            "empty_file",
                            "parse_failed",
                            "low_quality_scan",
                            "file_deleted",
                            "duplicate_file",
                            "customer_requested",
                            "other"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "description": "Human-readable error message"
                        }
                      }
                    },
                    "closed_at": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true,
                      "description": "ISO 8601 timestamp when the file was closed (only present when status is 'closed')"
                    }
                  }
                },
                "examples": {
                  "Processing": {
                    "summary": "Processing",
                    "value": {
                      "id": 769,
                      "status": "processing",
                      "portfolio_id": 580
                    }
                  },
                  "Done": {
                    "summary": "Done",
                    "value": {
                      "id": 769,
                      "status": "done",
                      "portfolio_id": 580
                    }
                  },
                  "Closed with error": {
                    "summary": "Closed with error",
                    "value": {
                      "id": 1234,
                      "status": "closed",
                      "portfolio_id": 5678,
                      "error": {
                        "code": "password_protected",
                        "message": "This document is password protected. Please remove the password and re-upload."
                      },
                      "closed_at": "2026-03-31T18:30:00Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request — file not found or access denied"
          }
        }
      }
    },
    "/api/v1.0/public/file_uploads/{id}/data": {
      "get": {
        "tags": [
          "/file_uploads/{id}/data"
        ],
        "summary": "Retrieve Data",
        "operationId": "file_uploads_data",
        "description": "Get processed transaction and portfolio data from an uploaded file.\n\nThe response structure in the `data` field varies by `statement_type`:\n\n| Statement Type | Data Structure |\n|----------------|----------------|\n| `brokerage` | `data.ownerships[]` — array of holdings with ticker, value, cost basis, asset class, etc. |\n| `tax_forms` | `data.forms[]` — array of tax form extractions with form type and reviewed data |\n| `trust` | `data.extracted_data` — trust document fields (grantors, trustees, distribution, etc.) |\n| `balance_sheet` | `data.ownerships[]` — array of $cash holdings, one per balance sheet line item (account name, value, account type) |\n\n### Bounding Box Citations\n\nWhen `enable_bbox_citations` is enabled for your firm **and** `include_bbox=true` is passed as a query parameter, each ownership includes a `bounding_boxes` field containing PDF coordinates for audited fields.\n\n**Response values:**\n- `null` — Feature not enabled for your firm\n- `{}` — Feature enabled, but no citation data available for this holding\n- `{field: {page, x1, y1, x2, y2}}` — Citation coordinates for each audited field\n\n**Coordinate system:** Values are percentages (0–100) of page dimensions. Format is XYXY — `x1,y1` is the top-left corner and `x2,y2` is the bottom-right corner.\n\n**Available fields in `bounding_boxes`:**\n\n| Field | Description |\n|-------|-------------|\n| `statement_asset_value` | Market value |\n| `quantity` | Share/unit quantity |\n| `statement_price` | Price per share/unit |\n| `statement_cost_basis` | Cost basis |\n| `statement_gain_loss` | Unrealized gain/loss |\n| `name` | Holding name |\n| `ticker` | Ticker symbol |\n\nOnly fields with citation data are included. Fields without bounding box data are omitted from the object.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "File upload ID"
          },
          {
            "name": "include_bbox",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "1",
                "false",
                "0"
              ],
              "default": "false"
            },
            "description": "Set to \"true\" or \"1\" to include per-field bounding box citations in the ownership response. Requires enable_bbox_citations to be enabled for your firm."
          }
        ],
        "responses": {
          "200": {
            "description": "Processed data retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "File upload ID"
                    },
                    "status": {
                      "type": "string",
                      "description": "File processing status"
                    },
                    "statement_type": {
                      "type": "string",
                      "description": "Type of statement processed"
                    },
                    "data": {
                      "type": "object",
                      "description": "Processed data payload — structure varies by statement_type (see endpoint description)"
                    },
                    "count": {
                      "type": "integer",
                      "description": "Number of items returned"
                    },
                    "page": {
                      "type": "integer",
                      "description": "Current page number (for paginated responses)"
                    }
                  }
                },
                "examples": {
                  "OK - holdings output": {
                    "summary": "OK - holdings output",
                    "value": {
                      "id": 5238,
                      "status": "done",
                      "data": {
                        "portfolio_id": 2542,
                        "ownerships": [
                          {
                            "name": "FDIC INSURED DEPOSIT AT FIFTH THIRD BANK IRANOT COVERED BY SIPC",
